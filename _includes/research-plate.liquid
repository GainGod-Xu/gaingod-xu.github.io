<figure class="research-plate">
  <img
    src="{{ include.image | relative_url }}"
    width="960"
    height="640"
    alt=""
    loading="lazy"
    decoding="async"
  >
  <figcaption class="fig-note">
    {{ include.caption | escape }}
    {% if include.source %}
      <a class="research-plate-source" href="{{ include.source | relative_url }}">{{ include.credit | escape }}</a>
    {% endif %}
  </figcaption>
</figure>
