---
layout: default
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,600&display=swap" rel="stylesheet" />
<style>
  @keyframes name-qi-glow {
    0%, 100% {
      text-shadow:
        0 0 4px #eafcff,
        0 0 10px #bdf3ff,
        0 0 18px #8fe9ff,
        0 0 28px #5fd0f2,
        0 0 40px #3aa9d8;
      color: #123047;
    }
    50% {
      text-shadow:
        0 0 6px #ffffff,
        0 0 16px #d3f9ff,
        0 0 26px #a6efff,
        0 0 40px #7fdcf5,
        0 0 56px #4fbde6;
      color: #0c2434;
    }
  }
  .artistic-name {
    display: inline-block;
    font-family: "Playfair Display", "Roboto Slab", serif;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.5px;
    animation: name-qi-glow 2.4s ease-in-out infinite;
  }
</style>
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="artistic-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

<canvas id="fx-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 9999;"></canvas>
<script>
  (function () {
    var canvas = document.getElementById('fx-canvas');
    var ctx = canvas.getContext('2d');
    var particles = [];
    var running = false;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    function randRange(a, b) {
      return a + Math.random() * (b - a);
    }

    function spawnPetal(x) {
      particles.push({
        type: 'petal',
        x: x,
        y: -20,
        vx: randRange(-0.3, 0.3),
        vy: randRange(0.8, 1.6),
        alpha: 1,
        size: randRange(8, 14),
        rotation: randRange(0, Math.PI * 2),
        rotationSpeed: randRange(-0.04, 0.04),
        sway: randRange(0.6, 1.6),
        swaySpeed: randRange(0.015, 0.03),
        swayPhase: randRange(0, Math.PI * 2),
        hue: randRange(330, 350),
        decay: randRange(0.0015, 0.003),
      });
    }

    function spawnSwordQi(x, y) {
      var count = 6;
      var baseAngle = randRange(0, Math.PI * 2);
      for (var i = 0; i < count; i++) {
        var angle = baseAngle + (Math.PI * 2 * i) / count + randRange(-0.15, 0.15);
        var speed = randRange(14, 24);
        particles.push({
          type: 'qi',
          x: x,
          y: y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          alpha: 1,
          length: randRange(55, 95),
          width: randRange(2, 3.5),
          decay: randRange(0.02, 0.032),
        });
      }
    }

    function step() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (var i = particles.length - 1; i >= 0; i--) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.type === 'petal') {
          p.rotation += p.rotationSpeed;
          p.swayPhase += p.swaySpeed;
          var drawX = p.x + Math.sin(p.swayPhase) * p.sway * 20;
          ctx.globalAlpha = Math.max(p.alpha, 0);
          ctx.save();
          ctx.translate(drawX, p.y);
          ctx.rotate(p.rotation);
          ctx.fillStyle = 'hsl(' + p.hue + ', 85%, 82%)';
          ctx.beginPath();
          ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = 'hsl(' + p.hue + ', 70%, 70%)';
          ctx.beginPath();
          ctx.ellipse(0, 0, p.size * 0.35, p.size * 0.2, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          if (p.y > canvas.height + 20) {
            p.alpha = 0;
          }
        } else if (p.type === 'qi') {
          var speedMag = Math.sqrt(p.vx * p.vx + p.vy * p.vy) || 1;
          var dx = (p.vx / speedMag) * p.length;
          var dy = (p.vy / speedMag) * p.length;
          ctx.globalAlpha = Math.max(p.alpha, 0);
          ctx.save();
          ctx.shadowColor = '#8fe9ff';
          ctx.shadowBlur = 14;
          var grad = ctx.createLinearGradient(p.x - dx, p.y - dy, p.x, p.y);
          grad.addColorStop(0, 'rgba(180, 245, 255, 0)');
          grad.addColorStop(1, '#eafcff');
          ctx.strokeStyle = grad;
          ctx.lineWidth = p.width;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(p.x - dx, p.y - dy);
          ctx.lineTo(p.x, p.y);
          ctx.stroke();
          ctx.restore();
          p.vx *= 0.96;
          p.vy *= 0.96;
        }

        if (p.alpha <= 0) {
          particles.splice(i, 1);
        }
      }
      ctx.globalAlpha = 1;

      if (particles.length > 0) {
        requestAnimationFrame(step);
      } else {
        running = false;
      }
    }

    function ensureRunning() {
      if (!running) {
        running = true;
        requestAnimationFrame(step);
      }
    }

    document.addEventListener('click', function (e) {
      spawnSwordQi(e.clientX, e.clientY);
      ensureRunning();
    });

    window.addEventListener('load', function () {
      var duration = 3000;
      var interval = 120;
      var elapsed = 0;
      var timer = setInterval(function () {
        var w = window.innerWidth;
        spawnPetal(randRange(0, w));
        ensureRunning();
        elapsed += interval;
        if (elapsed >= duration) {
          clearInterval(timer);
        }
      }, interval);
    });
  })();
</script>
